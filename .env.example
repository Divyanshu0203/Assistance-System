# Postgres connection string (Neon, Supabase or Vercel Postgres all work)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Long random string used to sign login cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Used only by `npm run db:seed` to create the first admin login
SEED_ADMIN_EMAIL="admin@school.test"
SEED_ADMIN_PASSWORD="change-this-password"